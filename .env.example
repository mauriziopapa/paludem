# ── Server ──
PORT=3000
NODE_ENV=production

# ── PLAUD Integration ──
# Mode: cli (default) | legacy_debug
PLAUD_INTEGRATION_MODE=cli
# Path to PLAUD CLI binary (default: "plaud" in PATH)
# PLAUD_CLI_PATH=/usr/local/bin/plaud
# CLI command timeout in ms (default: 30000)
# PLAUD_CLI_TIMEOUT=30000

# ── Legacy mode only (PLAUD_INTEGRATION_MODE=legacy_debug) ──
# PLAUD_BASE_URL=https://api.plaud.ai
# PLAUD_TOKEN=bearer eyJ...

# ── n8n AI Pipeline (optional) ──
# N8N_WEBHOOK_URL=https://your-n8n.app/webhook/xxxxx
# N8N_API_KEY=
# CALLBACK_BASE_URL=https://your-app.railway.app

# ── Session ──
# SESSION_TTL_MS=14400000
# CACHE_TTL_MS=1800000

# ── Logging ──
# LOG_LEVEL=info
