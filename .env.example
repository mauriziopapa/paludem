# ── Server ──
PORT=3000
NODE_ENV=production

# ── PLAUD Integration ──
# Mode: cli (default) | legacy_debug
PLAUD_INTEGRATION_MODE=cli

# ── PLAUD CLI Configuration ──
# CLI resolution mode: global (default) | npx
#   global → uses PLAUD_CLI_BIN from PATH (requires: npm i -g @plaud-ai/cli@latest)
#   npx    → uses npx -y PLAUD_CLI_NPX_PACKAGE (no global install needed)
PLAUD_CLI_MODE=global

# Binary name for global mode (default: "plaud")
# PLAUD_CLI_BIN=plaud

# Package for npx mode (default: @plaud-ai/cli@latest)
# PLAUD_CLI_NPX_PACKAGE=@plaud-ai/cli@latest

# PLAUD data directory (default: ~/.plaud)
# PLAUD_HOME=/app/.plaud

# CLI command timeout in ms (default: 60000)
# PLAUD_COMMAND_TIMEOUT_MS=60000

# ── Legacy mode only (PLAUD_INTEGRATION_MODE=legacy_debug) ──
# PLAUD_BASE_URL=https://api.plaud.ai
# PLAUD_TOKEN=bearer eyJ...

# ── n8n AI Pipeline (optional) ──
# N8N_WEBHOOK_URL=https://your-n8n.app/webhook/xxxxx
# N8N_API_KEY=
# CALLBACK_BASE_URL=https://your-app.railway.app

# ── Session ──
# SESSION_TTL_MS=14400000
# CACHE_TTL_MS=1800000

# ── Logging ──
# LOG_LEVEL=info
